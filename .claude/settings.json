{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5",
  "language": "japanese",
  "effortLevel": "high",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git remote *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(head *)",
      "Bash(wc *)",
      "Bash(sleep *)",
      "Bash(echo *)",
      "Bash(cp */new-app/* */new-app/*)",
      "Bash(curl -s *posseacademy.github.io*)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -f *)",
      "Bash(git clean -fd *)",
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git filter-branch *)",
      "Bash(git reflog expire *)",
      "Bash(git update-ref -d *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/credentials*)",
      "Read(./**/*secret*)",
      "Read(./**/*token*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/service-account*.json)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh release *)",
      "Bash(gh repo edit *)",
      "Bash(gh gist create *)",
      "Bash(gh api *)",
      "Bash(gh secret set *)",
      "Bash(gh workflow run *)",
      "Bash(gh repo create *)",
      "Bash(curl * -d *)",
      "Bash(curl -X POST *)",
      "Read(./backups/**)",
      "Read(./posse-backup-*.json)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/auto-commit.sh"
          }
        ]
      }
    ]
  }
}
